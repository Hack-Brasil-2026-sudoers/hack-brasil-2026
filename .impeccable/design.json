  "narrative": {
    "northStar": "The Investigation Workspace",
    "overview": "This system describes only the operational demo in `static/demo/`. It does not govern the separate marketing website. The user's pinned identity is a minimal professional interface in black and dark navy, with Inter for interface text and JetBrains Mono for technical evidence.\n\nThe shipped workspace favors quiet investigation lists, precise revision context, and secondary coverage information. Containers organize forms, reports, and detail views without turning every metric into a card. The metaphor names the existing implementation; it is not a replacement visual identity.",
    "keyCharacteristics": [
      "Black canvas and tonal navy surfaces with discreet cool borders.",
      "Stable semantic priority colors, separate from confidence and analysis state.",
      "Inter hierarchy paired with monospaced identifiers and evidence.",
      "Investigation lists with compact counts and secondary coverage.",
      "Flat surfaces, visible keyboard focus, and restrained state transitions."
    ],
    "rules": [
      {
        "name": "The Semantic Separation Rule",
        "body": "Priority, confidence, and coverage retain separate labels. A completion color or finding count never implies a security score.",
        "section": "colors"
      },
      {
        "name": "The Evidence Type Rule",
        "body": "Reserve mono for literal code, paths, and identifiers; keep explanations and actions in Inter.",
        "section": "typography"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "Use separators for investigation rows and compact count groups. Add a container when it groups a form, report, or contextual detail, rather than as decoration around every datum.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** preserve the black and dark navy identity, Inter interface text, and JetBrains Mono technical values.",
      "**Do** pair semantic color with words and keep confidence separate from priority.",
      "**Do** preserve exact revision context, visible incomplete coverage, and explicit time zones.",
      "**Do** use quiet lists and discreet separators when presenting investigation work.",
      "**Do** keep keyboard focus visible and retain reduced-motion behavior."
    ],
    "donts": [
      "**Don't** introduce decorative neon, excessive gradients, or unnecessary ornament.",
      "**Don't** interpret a green completion state or a finding count as a security guarantee or score.",
      "**Don't** replace every information group with a dashboard card.",
      "**Don't** generalize compact footer text or opacity-only disabled styling into defaults for new screens.",
      "**Don't** apply this operational-demo system to the separate marketing website without its own design decision."
    ]
  }
}
