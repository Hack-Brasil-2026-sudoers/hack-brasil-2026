# Gere seu token: python -c "import secrets; print(secrets.token_urlsafe(32))"
CYBERCHECK_API_TOKEN=
CYBERCHECK_DATA_DIR=.data
# GitHub App: Contents read-only, Metadata read-only; instalação nos repos autorizados.
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
# Caminho para a chave PEM; nunca copie a chave para o repositório.
GITHUB_PRIVATE_KEY_PATH=
# Executáveis instalados separadamente. Use Betterleaks 1.x nesta primeira versão.
OSV_SCANNER_BIN=osv-scanner
BETTERLEAKS_BIN=betterleaks
CYBERCHECK_SCANNER_TIMEOUT=120
# Interface da demo será implementada por outro integrante; configure origens exatas.
CYBERCHECK_CORS_ORIGINS=
