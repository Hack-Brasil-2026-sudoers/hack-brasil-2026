# Generate your token: python -c "import secrets; print(secrets.token_urlsafe(32))"
CYBERCHECK_API_TOKEN=
CYBERCHECK_DATA_DIR=.data
# GitHub App: Contents read-only, Metadata read-only; install on authorized repositories.
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
# Path to the PEM key; never copy the key into the repository.
GITHUB_PRIVATE_KEY_PATH=
# Optional GitHub user login. Configure all three together; never commit real values.
# Client ID/secret belong to the GitHub App, not a separate OAuth App.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# API and worker must share this key. Keep it stable across restarts.
CYBERCHECK_SESSION_KEY=
CYBERCHECK_PUBLIC_URL=http://127.0.0.1:8000
# Executables installed separately. Use Betterleaks 1.x for this initial version.
OSV_SCANNER_BIN=osv-scanner
BETTERLEAKS_BIN=betterleaks
CYBERCHECK_SCANNER_TIMEOUT=120
# Another team member will implement the demo UI; configure exact allowed origins.
CYBERCHECK_CORS_ORIGINS=
